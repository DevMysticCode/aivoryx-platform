flowchart TB
    DEV["Developer machines"] --> GH["GitHub"]
    GH --> CI["CI<br/>typecheck / lint / Vitest / Playwright /<br/>Drizzle migration validate / secret scan"]

    CI --> VC["Vercel"]
    CI --> RW["Railway (per environment project)"]

    subgraph VERCEL["Vercel (public)"]
      WEBAPP["Next.js web app<br/>SSR + PWA"]
    end
    VC --> WEBAPP

    subgraph RAILWAY["Railway project (private network)"]
      API["NestJS API<br/>/api/v1 (public HTTPS)"]
      WORKER["BullMQ worker(s)<br/>no public port"]
      PG[("PostgreSQL<br/>private only")]
      REDIS[("Redis (AOF)<br/>private only")]
    end
    RW --> API
    RW --> WORKER
    RW --> PG
    RW --> REDIS

    WEBAPP -- "HTTPS + session cookie + CSRF" --> API
    API -- private --> PG
    API -- private --> REDIS
    WORKER -- private --> PG
    WORKER -- private --> REDIS

    API -- "S3 API / presigned URLs" --> R2["Cloudflare R2<br/>(S3-compatible, private buckets)"]
    WORKER --> R2

    API -- "inbound webhooks / email" --> EXT["External providers"]
    WORKER -- "rest_pull / outbound" --> EXT
