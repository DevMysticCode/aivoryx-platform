# =============================================================================
# Aivoryx Platform — environment template
# Copy to `.env` for local development:  cp .env.example .env
# NEVER commit a real `.env`. Only `.env.example` is tracked.
# =============================================================================

# --- Runtime -----------------------------------------------------------------
# One of: development | test | staging | production
APP_ENV=development
NODE_ENV=development
LOG_LEVEL=debug

# --- API (apps/api) — SERVER ONLY, never exposed to the browser -------------
API_PORT=4000
# Public base URL the browser/SSR uses to reach the API.
API_BASE_URL=http://localhost:4000
# Comma-separated list of allowed browser origins for CORS (credentials mode).
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Database — SERVER ONLY ------------------------------------------------
# Local docker-compose default (non-standard port, see docker-compose.yml).
# On Railway this is injected as a service reference.
DATABASE_URL=postgres://postgres:postgres@localhost:55432/aivoryx
# Max pool size for the app (request-serving) role.
DATABASE_POOL_MAX=10
# Non-privileged role the API SET ROLEs to so Row Level Security always applies
# (ADR 0027). Created by migration 0003. Must not be superuser / BYPASSRLS.
DATABASE_APP_ROLE=aivoryx_app

# --- Redis / BullMQ — SERVER ONLY ----------------------------------------
# Local docker-compose default (non-standard port, see docker-compose.yml).
# On Railway this is injected as a service reference.
REDIS_URL=redis://localhost:56379

# --- Sessions — SERVER ONLY ---------------------------------------------
# 32+ random bytes, base64/hex. Generate: openssl rand -base64 48
SESSION_SECRET=change-me-generate-a-long-random-value
SESSION_COOKIE_NAME=aivoryx_session
# Session expiry (server-enforced). Absolute lifetime and idle timeout, in hours.
SESSION_ABSOLUTE_TTL_HOURS=720
SESSION_IDLE_TTL_HOURS=168
# Cookie flags. SESSION_COOKIE_SECURE defaults to true outside development.
# SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=lax

# --- Password hashing (Argon2id, ADR 0010/0028) — SERVER ONLY ----------
ARGON2_MEMORY_KIB=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1

# --- Object storage (S3-compatible / Cloudflare R2) — SERVER ONLY -------
# Optional in Phase 1. Local storage is deferred (see CLAUDE.md / decisions).
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=

# --- Web (apps/web) --------------------------------------------------------
WEB_PORT=3000
# ONLY NEXT_PUBLIC_* values reach the browser bundle. Keep them non-sensitive.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
NEXT_PUBLIC_APP_ENV=development
