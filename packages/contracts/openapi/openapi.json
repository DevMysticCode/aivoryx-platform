            "allOf": [
              {
                "$ref": "#/components/schemas/ActiveContextDto"
              }
            ]
          },
          "sessionExpiresAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "user",
          "memberships",
          "active",
          "sessionExpiresAt"
        ]
      },
