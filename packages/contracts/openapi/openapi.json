          },
          "memberships": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MembershipSummaryDto"
            }
          },
          "active": {
            "nullable": true,
            "description": "Null until the session has a usable active tenant.",
            "allOf": [
              {
                "$ref": "#/components/schemas/ActiveContextDto"
              }
            ]
          },
          "sessionExpiresAt": {
            "type": "string",
            "format": "date-time"
          }
