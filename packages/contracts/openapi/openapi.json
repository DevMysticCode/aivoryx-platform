  "info": {
    "title": "Aivoryx Platform API",
    "description": "Code-first OpenAPI contract. Regenerate with `pnpm contracts:generate`.",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [
    {
      "url": "/api/v1"
    }
  ],
  "components": {
    "securitySchemes": {
      "cookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "aivoryx_session",
        "description": "HTTP-only session cookie (ADR 0010). Set by the auth endpoints in Phase 2."
      }
    },
    "schemas": {
      "LivenessReportDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ]
          },
          "uptimeSeconds": {
            "type": "number",
            "example": 1234
          }
        },
        "required": [
          "status",
          "uptimeSeconds"
        ]
      },
      "DependencyHealthDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "error"
            ]
          },
          "latencyMs": {
            "type": "number",
            "example": 12
          },
          "detail": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "status",
          "latencyMs"
        ]
      },
      "HealthChecksDto": {
        "type": "object",
        "properties": {
          "database": {
            "$ref": "#/components/schemas/DependencyHealthDto"
          },
          "redis": {
            "$ref": "#/components/schemas/DependencyHealthDto"
          }
        },
        "required": [
          "database",
          "redis"
        ]
      },
      "HealthReportDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "error"
            ]
          },
          "correlationId": {
            "type": "string",
            "example": "AIV-01J9Z8ABCDEF0123456789"
          },
          "checks": {
            "$ref": "#/components/schemas/HealthChecksDto"
          }
        },
        "required": [
          "status",
          "correlationId",
          "checks"
        ]
      },
      "LoginRequestDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "example": "admin@acme.test"
          },
          "password": {
            "type": "string",
            "minLength": 8,
            "maxLength": 200,
            "example": "correct horse battery staple"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "AuthUserDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "disabled"
            ]
          }
        },
        "required": [
          "id",
          "email",
          "status"
        ]
      },
      "MembershipSummaryDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "tenantId": {
            "type": "string",
            "format": "uuid"
          },
          "tenantSlug": {
            "type": "string",
            "example": "acme"
          },
          "tenantName": {
            "type": "string",
            "example": "Acme Inc."
          },
          "tenantStatus": {
            "type": "string",
            "enum": [
              "active",
              "suspended"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "suspended",
              "invited"
            ]
          }
        },
        "required": [
          "id",
          "tenantId",
          "tenantSlug",
          "tenantName",
          "tenantStatus",
          "status"
        ]
      },
      "ActiveContextDto": {
        "type": "object",
        "properties": {
          "membership": {
            "$ref": "#/components/schemas/MembershipSummaryDto"
          },
          "permissions": {
            "description": "Permission keys granted in this tenant.",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "roles": {
            "description": "Role keys held in this tenant.",
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "membership",
          "permissions",
          "roles"
        ]
      },
      "LoginResponseDto": {
        "type": "object",
        "properties": {
          "user": {
            "$ref": "#/components/schemas/AuthUserDto"
          },
          "memberships": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MembershipSummaryDto"
            }
          },
          "active": {
            "nullable": true,
            "description": "Null until the session has a usable active tenant.",
            "allOf": [
              {
                "$ref": "#/components/schemas/ActiveContextDto"
              }
            ]
          },
          "sessionExpiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "tenantAutoSelected": {
            "type": "boolean",
            "description": "True when the single-membership user was auto-selected into a tenant."
          }
        },
        "required": [
          "user",
          "memberships",
          "active",
          "sessionExpiresAt",
          "tenantAutoSelected"
        ]
      },
      "ApiErrorDetailDto": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "correlationId": {
            "type": "string",
            "example": "AIV-01J9Z8ABCDEF0123456789"
          },
          "details": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "required": [
          "code",
          "message",
          "correlationId"
        ]
      },
