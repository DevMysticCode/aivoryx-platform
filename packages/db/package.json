{
  "name": "@aivoryx/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema/index.d.ts",
      "default": "./dist/schema/index.js"
    }
  },
  "files": [
    "dist",
    "drizzle"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint \"src/**/*.ts\"",
    "test": "vitest run",
    "db:generate": "pnpm run build && drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=../../.env src/migrate.ts",
    "db:studio": "pnpm run build && drizzle-kit studio",
    "clean": "rimraf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@aivoryx/config": "workspace:*",
    "@aivoryx/shared": "workspace:*",
    "drizzle-orm": "0.38.3",
    "pg": "8.13.1",
    "uuidv7": "1.0.2"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@types/pg": "8.11.10",
    "drizzle-kit": "0.30.1",
    "eslint": "9.17.0",
    "rimraf": "6.0.1",
    "tsx": "4.19.2",
    "typescript": "5.7.2",
    "vitest": "2.1.8"
  }
}
