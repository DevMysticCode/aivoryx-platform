{
  "name": "@aivoryx/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint \"src/**/*.ts\" \"scripts/**/*.mjs\" \"scripts/**/*.ts\"",
    "test": "vitest run",
    "openapi:extract": "pnpm run build && node scripts/extract-openapi.mjs",
    "seed:field-demo": "tsx --env-file-if-exists=../../.env scripts/seed-field-demo.ts",
    "seed:supply-demo": "tsx --env-file-if-exists=../../.env scripts/seed-supply-demo.ts",
    "clean": "rimraf dist .turbo *.tsbuildinfo",
    "seed:commercial-demo": "tsx --env-file-if-exists=../../.env scripts/seed-commercial-demo.ts",
    "seed:execution-demo": "tsx --env-file-if-exists=../../.env scripts/seed-execution-demo.ts",
    "seed:notifications-demo": "tsx --env-file-if-exists=../../.env scripts/seed-notifications-demo.ts",
    "seed:finance-demo": "tsx --env-file-if-exists=../../.env scripts/seed-finance-demo.ts",
    "seed:hr-demo": "tsx --env-file-if-exists=../../.env scripts/seed-hr-demo.ts",
    "seed:platform-demo": "tsx --env-file-if-exists=../../.env scripts/seed-platform-demo.ts"
  },
  "dependencies": {
    "@aivoryx/config": "workspace:*",
    "@aivoryx/contracts": "workspace:*",
    "@aivoryx/db": "workspace:*",
    "@aivoryx/shared": "workspace:*",
    "@nestjs/common": "11.0.1",
    "@nestjs/core": "11.0.1",
    "@nestjs/platform-express": "11.0.1",
    "@nestjs/swagger": "8.1.0",
    "@node-rs/argon2": "2.0.2",
    "bullmq": "5.34.5",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.1",
    "cookie-parser": "1.4.7",
    "drizzle-orm": "0.38.3",
    "helmet": "8.0.0",
    "ioredis": "5.4.2",
    "multer": "1.4.5-lts.1",
    "nestjs-pino": "4.2.0",
    "nodemailer": "6.9.16",
    "pdfmake": "0.2.12",
    "pino": "9.5.0",
    "pino-http": "10.3.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1",
    "ulid": "2.3.0"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.0",
    "@nestjs/schematics": "11.0.0",
    "@nestjs/testing": "11.0.1",
    "@swc/core": "1.10.7",
    "@types/cookie-parser": "1.4.8",
    "@types/express": "5.0.0",
    "@types/multer": "^2.2.0",
    "@types/node": "22.10.2",
    "@types/nodemailer": "6.4.17",
    "@types/pdfkit": "0.13.9",
    "@types/pdfmake": "0.2.9",
    "@types/pg": "8.11.10",
    "@types/supertest": "6.0.2",
    "eslint": "9.17.0",
    "pdf-lib": "1.17.1",
    "pg": "8.13.1",
    "pino-pretty": "13.0.0",
    "rimraf": "6.0.1",
    "supertest": "7.0.0",
    "tsx": "4.19.2",
    "typescript": "5.7.2",
    "unplugin-swc": "1.5.1",
    "vitest": "2.1.8"
  }
}
